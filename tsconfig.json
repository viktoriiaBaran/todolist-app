{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@components/*": ["src/components/*"],
      "@screens/*": ["src/screens/*"],
      "@screens/": ["src/screens"],
      "@navigation/*": ["src/navigation/*"],
      "@navigation": ["src/navigation"],
      "@assets/*": ["src/assets/*"],
      "@assets": ["src/assets"],
      "@utils/*": ["src/utils/*"],
      "@utils": ["src/utils"]
    }
  }
}
